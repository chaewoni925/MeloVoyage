require("dotenv").config();
const { GoogleGenAI } = require("@google/genai");

const genMoodDictionary = require("../genreMoodDictionary.json"); // 곡 무드 사전을 참고 어휘로 재사용

const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });

const MODEL = "gemini-2.5-flash-lite";
const MAX_RETRIES = 2;
const BASE_BACKOFF_MS = 3000;

function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

// -----------------------------
// 프롬프트 구성 (곡 태깅 프롬프트와 동일한 스타일)
// -----------------------------

function buildPrompt({ name, category }) {
    return `
너는 여행지 분위기를 태깅하는 전문가야.
아래 장소에 대해, 그 장소만의 고유한 정서가 드러나는 
한글 무드 태그를 6~8개 생성해줘. 이 태그들은 음악 추천에 
쓰이는 텍스트로 임베딩되니, 구체적인 지명이나 건축물 이름보다는 
"감성/분위기를 나타내는 단어" 위주로 뽑아줘.

장소명: ${name}
카테고리: ${category}

규칙:
- "자연", "힐링", "감성", "여유", "드라이브" 같은 어떤 여행지에나 붙일 수 있는 
  뻔한 단어는 최대 1~2개까지만 쓰고, 나머지는 그 장소만의 
  정서를 더 구체적으로 표현해줘.
- "바다", "섬", "산", "숲"처럼 그 자체로 이미 보편적이고 
  감성적으로도 통하는 기본 지리 단어는 자유롭게 써도 좋아.
- 지형이나 랜드마크(오름, 현무암, 고분 등)를 직접 태그로 쓰지 말고, 
  그게 주는 느낌을 형용사/감성 단어로 바꿔서 표현해줘.
  예: 오름이 있는 곳 → "완만함", "탁 트인" / 돌담길 → "정겨움", "소박함"
  / 고분/유적이 있는 곳 → "고요함", "아득함", "예스러움"
- 그 장소가 다른 비슷한 여행지들과 어떻게 다른 정서인지 
  구별되게 표현해줘.
  예: 같은 "바다"여도 제주는 "이국적, 청량함", 강릉은 
  "드라이브, 레트로", 부산은 "활기, 밤바다"처럼 다르게.

- 반드시 아래 JSON 형식으로만 응답해. 다른 설명이나 마크다운 없이 순수 JSON만.
- 정확히 6개의 태그를 생성해줘. 6개보다 적거나 많으면 안 돼.

형식:
{ "moodTags": ["태그1", "태그2", "태그3", "태그4", "태그5", "태그6"] }
`;
}
